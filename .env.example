# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server only. Required by the image upload endpoint after checking user permissions.
# Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server and standalone worker. Use the real public app URL in production.
APP_URL=http://localhost:3000
# Generate a random secret of at least 32 characters; use the same value in cron.
WORKER_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Public local previews: honored only for loopback hosts, never for production domains.
ENABLE_LOCAL_SITES=false
# Optional organization-slug/site-slug shown at localhost:3000/.
LOCAL_PUBLIC_SITE=

# Contact forms: independent server-only HMAC key, at least 32 random characters.
CONTACT_FORM_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
# Production: name of an IP header overwritten by your trusted reverse proxy.
# Do not use a client-controlled or merely forwarded header. Missing/invalid header fails closed.
CONTACT_IP_HEADER=
